# syntax=docker/dockerfile:1

# -----------------------------------------------------------------------------
# Builder — same musl-static toolchain as Containerfile. The migrate binary
# is invoked by the compose `migrate` service (one-shot) to apply sqlx
# migrations before the server starts. See Containerfile for the base image
# rationale (messense/rust-musl-cross sidesteps the cc1/-m64 issue on
# `rust:1-bookworm`).
# -----------------------------------------------------------------------------
FROM messense/rust-musl-cross:x86_64-musl AS builder

WORKDIR /build

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends protobuf-compiler \
 && rm -rf /var/lib/apt/lists/*

ENV CC_x86_64_unknown_linux_musl=x86_64-unknown-linux-musl-gcc \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=x86_64-unknown-linux-musl-gcc \
    RUSTFLAGS="-C link-arg=-static -C target-feature=+crt-static"

COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY proto ./proto
COPY migrations ./migrations

RUN cargo build --release \
    --target x86_64-unknown-linux-musl \
    --bin migrate

# -----------------------------------------------------------------------------
# Final — distroless/static, nonroot. Mirrors Containerfile.
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder --chown=nonroot:nonroot \
    /build/target/x86_64-unknown-linux-musl/release/migrate /migrate

USER nonroot:nonroot

ENTRYPOINT ["/migrate"]
